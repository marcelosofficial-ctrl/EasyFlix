<Window x:Class="EasyFlix.App.ProviderSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Provider readiness" Width="680" Height="900" MinHeight="700"
        Background="#0B0D12" Foreground="#F6F7FB" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#8B7CFF"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#10151E"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3C4659"/><Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="ProviderCard" TargetType="Border">
            <Setter Property="Background" Value="#151A24"/><Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Provider readiness" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="See what works locally, what uses the internet, and which optional keys are configured."
                       Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,7,0,18"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <Border Style="{StaticResource ProviderCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Local library tools" FontWeight="SemiBold"/>
                            <TextBlock Text="Scanning, grouping, shortcuts, and filename cleanup never require an account or internet connection."
                                       Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,4,12,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="READY" Foreground="#65D9A6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ProviderCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Set up account" Tag="https://www.opensubtitles.com/en/consumers" Click="OpenLink_Click" Background="#293145" Padding="12,7"/>
                            <StackPanel>
                                <TextBlock Text="OpenSubtitles ┬╖ Verified fallback" FontWeight="SemiBold"/>
                                <TextBlock x:Name="OpenSubtitlesStatus" Foreground="#EBCB78" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="Optional second source for human-made SRTs. Searches prefer a local movie hash, with exact title/year/episode matching for custom encodes. AI and machine-translated results are excluded. Your account's own daily quota applies."
                                   Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,8,0,10"/>
                        <TextBlock Text="Username" Foreground="#B4BDCC" FontSize="12"/>
                        <PasswordBox x:Name="OpenSubtitlesUsername" Margin="0,3,0,8"/>
                        <TextBlock Text="Password" Foreground="#B4BDCC" FontSize="12"/>
                        <PasswordBox x:Name="OpenSubtitlesPassword" Margin="0,3,0,8"/>
                        <TextBlock Text="Consumer API key" Foreground="#B4BDCC" FontSize="12"/>
                        <PasswordBox x:Name="OpenSubtitlesApiKey" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProviderCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TVmaze ┬╖ TV and anime covers" FontWeight="SemiBold"/>
                            <TextBlock Text="Automatic internet lookup. No account or API key required. Only a cleaned title/year search is sent."
                                       Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,4,12,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="NO KEY" Foreground="#65D9A6" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ProviderCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Get a key" Tag="https://www.themoviedb.org/settings/api" Click="OpenLink_Click" Background="#293145" Padding="12,7"/>
                            <StackPanel>
                                <TextBlock Text="TMDB ┬╖ Movie covers" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TmdbStatus" Foreground="#EBCB78" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="An optional free TMDB API key is required for movie metadata and posters. Successful metadata is saved to the local catalog and images are cached locally, so normal startup and library refresh do not need TMDB."
                                   Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB."
                                   Foreground="#8894A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="TmdbKey"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProviderCard}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Get a key" Tag="https://subdl.com/panel/api" Click="OpenLink_Click" Background="#293145" Padding="12,7"/>
                            <StackPanel>
                                <TextBlock Text="SubDL ┬╖ Existing subtitles" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SubDlStatus" Foreground="#EBCB78" FontSize="12" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="A SubDL account/API key is required. EasyFlix accepts only direct, checksum-verified SRT files and never overwrites existing subtitles."
                                   Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,8,0,8"/>
                        <PasswordBox x:Name="SubDlKey"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ProviderCard}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FFprobe ┬╖ Local subtitle audit" FontWeight="SemiBold"/>
                            <TextBlock Text="Reads local audio/subtitle metadata. It does not upload media and does not require an account."
                                       Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,4,12,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="FfprobeStatus" Text="CHECKING" Foreground="#EBCB78" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource ProviderCard}" Background="#171724">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Whisper ┬╖ Offline speech-to-text" FontWeight="SemiBold"/>
                            <TextBlock Text="No account or API key. Downloads a multilingual model once, then runs locally with resumable history and never overwrites an SRT."
                                       Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,4,12,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="WhisperStatus" Text="CHECKING" Foreground="#EBCB78" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="FfmpegStatus" Text="FFMPEG: CHECKING" Foreground="#B4BDCC" FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="New credentials are encrypted for this Windows account. Leave a field blank to keep its existing value."
                           Foreground="#B4BDCC" TextWrapping="Wrap" Margin="0,4,0,12"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Remove saved keys" Background="#4A2934" Margin="0,0,10,0" Click="Remove_Click"/>
            <Button Content="Cancel" Background="#252B38" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save securely" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
