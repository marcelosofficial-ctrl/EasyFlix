<Window x:Class="EasyFlix.App.MediaIntakeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyFlix - Add Media Center"
        Width="1080" Height="780" MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#05060A" Foreground="#F8FAFF"
        Opacity="0"
        Loaded="Window_Loaded"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="GuideActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F8FAFF"/>
            <Setter Property="Background" Value="#151A23"/>
            <Setter Property="BorderBrush" Value="#344154"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#20283A"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#7B6CFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#292F4B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryGuideActionButton" TargetType="Button" BasedOn="{StaticResource GuideActionButton}">
            <Setter Property="Background" Value="#5B55C8"/>
            <Setter Property="BorderBrush" Value="#7B6CFF"/>
        </Style>
    </Window.Resources>

    <Grid Background="#05060A">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#080B11" BorderBrush="#171E29" BorderThickness="0,0,0,1" Padding="30,22">
            <Grid MaxWidth="980" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#181536" BorderBrush="#5B55C8" BorderThickness="1"
                                CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock Text="MEDIA SETUP" Foreground="#B9B2FF" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#0D2026" BorderBrush="#23505B" BorderThickness="1"
                                CornerRadius="12" Padding="10,4">
                            <TextBlock Text="LOCAL-FIRST" Foreground="#75E6F7" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Add Media Center" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/>
                    <TextBlock Text="Drop one EasyFlix .easyflixhandoff/.txt/.json handoff here, or choose Import Media Handoff. EasyFlix handles the rest."
                               Foreground="#AEB9C9" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GuideActionButton}" Content="Import Media Handoff"
                            Click="ImportHandoff_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource GuideActionButton}" Content="Copy AI Instructions"
                            Click="CopyAi_Click" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource PrimaryGuideActionButton}" Content="Save AI Handoff (.txt)"
                            Click="SaveAi_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="980" HorizontalAlignment="Center" Margin="30,26,30,34">
                <Border Background="#101621" BorderBrush="#263143" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="4" Background="#7B6CFF" CornerRadius="2" Margin="0,1,16,1"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="The one rule to remember" Foreground="#F8FAFF" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,6,0,0" Foreground="#C7D0DD" TextWrapping="Wrap"
                                       Text="Your video files stay in your media folders/drives. EasyFlix scans them. Routine intake should not require database edits, Git, Codex, or rebuilding the app."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,22,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#0B0E14" BorderBrush="#344154" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="POSTER COMPOSITION" Foreground="#8E9AAD" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Left"/>
                            <Border Width="160" Height="240" Margin="0,14,0,12"
                                    Background="#151A23" BorderBrush="#7B6CFF" BorderThickness="1" CornerRadius="6">
                                <Grid ClipToBounds="True">
                                    <Border Margin="13,13,13,54" Background="#171E29" BorderBrush="#35D3FF"
                                            BorderThickness="1" CornerRadius="4">
                                        <TextBlock Text="Keep faces, logos, and key art in this safe area"
                                                   Foreground="#C7D0DD" TextAlignment="Center" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" Margin="14"/>
                                    </Border>
                                    <Border VerticalAlignment="Bottom" Height="48" Background="#E60B0E14" Padding="10,7">
                                        <StackPanel>
                                            <TextBlock Text="Title / metadata overlay" Foreground="#F8FAFF" FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock Text="Avoid critical detail here" Foreground="#8E9AAD" FontSize="9"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Text="190 x 286 card  &#x2022;  ~2:3 portrait" Foreground="#C7D0DD" FontSize="11"/>
                            <TextBlock Text="1200 x 1800 recommended, not required" Foreground="#8E9AAD"
                                       FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#0B0E14" BorderBrush="#344154" BorderThickness="1" CornerRadius="12" Padding="22">
                        <StackPanel>
                            <TextBlock Text="Artwork: hard behavior vs recommendation" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#C7D0DD"
                                       Text="HARD BEHAVIOR  &#x2022;  Main library cards render at 190&#x00D7;286 with a high-quality centered UniformToFill crop. Cards stay filled and artwork remains center-anchored at every window size; no title-specific left/right offsets are used. Explicit metadata sync downloads provider artwork, caps each download at 10 MB, converts it to PNG, and caches it locally."/>
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#B9B2FF"
                                       Text="RECOMMENDATION  &#x2022;  Use a clean portrait image close to 2:3. 1200&#x00D7;1800 or 1000&#x00D7;1500 gives plenty of source detail. Keep critical art away from edges and especially the bottom ~20%."/>
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#75E6F7"
                                       Text="CUSTOM ART  &#x2022;  Import Media Handoff can cache an explicitly supplied local poster into EasyFlix. Normal Refresh still does not treat arbitrary poster.jpg/folder.jpg sidecars as an intake contract."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding GuideSections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#0B0E14" BorderBrush="#263143" BorderThickness="1"
                                    CornerRadius="10" Padding="20" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="#7B6CFF" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Title}" Foreground="#F8FAFF" FontSize="18"
                                               FontWeight="SemiBold" Margin="0,5,0,7"/>
                                    <TextBlock Text="{Binding Body}" Foreground="#C7D0DD" TextWrapping="Wrap" LineHeight="19"/>
                                    <Border Background="#080B11" BorderBrush="#1C2735" BorderThickness="1"
                                            CornerRadius="6" Padding="12,9" Margin="0,12,0,0">
                                        <TextBlock Text="{Binding Example}" Foreground="#9FE8F5" FontFamily="Consolas"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="#101621" BorderBrush="#263143" BorderThickness="1" CornerRadius="12"
                        Padding="20" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Need an AI months from now?" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,7,0,0" Foreground="#C7D0DD" TextWrapping="Wrap"
                                   Text="Use Copy AI Instructions or Save AI Handoff (.txt) to teach any AI the exact batch format. A completed batch may be saved as .easyflixhandoff, .txt, or .json and imported here."/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="HandoffAssociationButton" Style="{StaticResource GuideActionButton}"
                                    Content="Enable .easyflixhandoff double-click" Click="HandoffAssociation_Click"/>
                            <TextBlock x:Name="HandoffAssociationStatus" Margin="14,0,0,0" VerticalAlignment="Center"
                                       Foreground="#8E9AAD" Text="Double-click integration is optional and per-user."/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#080B11" BorderBrush="#171E29" BorderThickness="0,1,0,0" Padding="28,12">
            <Grid MaxWidth="980" HorizontalAlignment="Center">
                <TextBlock x:Name="ActionStatus" Foreground="#8E9AAD" VerticalAlignment="Center"
                           Text="Drop one .easyflixhandoff/.txt/.json handoff anywhere in this window. Import stays local and does not run provider sync."/>
                <Button Style="{StaticResource GuideActionButton}" Content="Close" Click="Close_Click"
                        HorizontalAlignment="Right" MinWidth="92"/>
            </Grid>
        </Border>
    </Grid>
</Window>
