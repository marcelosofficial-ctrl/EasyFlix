<Window x:Class="EasyFlix.App.PlaybackHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Watch history" Width="980" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#0B0E14" Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Watch history" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock Text="Recent meaningful playback activity. Clear removes only the saved progress for that exact media file."
                           Foreground="#AEB8C7" TextWrapping="Wrap" Margin="0,8,0,16"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,0,0,0">
                <ComboBox x:Name="HistoryFilter" Width="135" Height="32" Margin="0,0,8,0"
                          SelectionChanged="HistoryFilter_SelectionChanged">
                    <ComboBoxItem Content="All" Tag="All"/>
                    <ComboBoxItem Content="In progress" Tag="InProgress"/>
                    <ComboBoxItem Content="Watched" Tag="Watched"/>
                </ComboBox>
                <Button Content="Clear all history" Width="130" Height="32" Click="ClearAll_Click"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#121722" BorderBrush="#27303D" BorderThickness="1"
                                CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#0F141D" CornerRadius="5" Margin="0,0,14,0">
                                    <Image Source="{Binding Title.ArtworkPath}" Stretch="UniformToFill"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title.DisplayTitle}" FontSize="17" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ContextText}" Foreground="#C7D2E3" FontSize="12" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ProgressText}" Foreground="#AEB8C7" FontSize="12" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding UpdatedText}" Foreground="#758195" FontSize="11" Margin="0,3,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <Button Content="Open details" Width="110" Height="32" Margin="0,0,0,7"
                                            Click="Open_Click" Tag="{Binding}"/>
                                    <Button Content="Clear progress" Width="110" Height="32"
                                            Click="Clear_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="HistoryStatus" Grid.Row="2" Foreground="#AEB8C7" FontSize="12" Margin="0,12,0,0"/>
    </Grid>
</Window>
