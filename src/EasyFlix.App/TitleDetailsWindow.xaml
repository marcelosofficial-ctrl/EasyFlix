<Window x:Class="EasyFlix.App.TitleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyFlix Details" Width="1080" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#0B0E14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#121722" BorderBrush="#27303D" BorderThickness="1" CornerRadius="8" Margin="0,0,22,0">
                <Grid>
                    <Image Source="{Binding ArtworkPath}" Stretch="UniformToFill"/>
                    <TextBlock Text="EasyFlix" Foreground="#566174" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" Foreground="White" FontSize="34" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Meta}" Foreground="#B4BECD" FontSize="13" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding Description}" Foreground="#D2D8E1" FontSize="14" Margin="0,14,0,0"
                           TextWrapping="Wrap" MaxWidth="820"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.8*"/>
            </Grid.ColumnDefinitions>

            <Border Background="#121722" BorderBrush="#27303D" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Files and episodes" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                             SelectionChanged="EntryList_SelectionChanged" Background="#0F141D" Foreground="White" BorderBrush="#27303D">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="#121722" BorderBrush="#27303D" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Before playback" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                    <TextBlock Text="Audio" Foreground="#AEB8C7" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudio}" DisplayMemberPath="Label"
                              Height="34" Margin="0,0,0,14"/>
                    <TextBlock Text="Subtitles" Foreground="#AEB8C7" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding SubtitleTracks}" SelectedItem="{Binding SelectedSubtitle}" DisplayMemberPath="Label"
                              Height="34" Margin="0,0,0,14"/>
                    <TextBlock Text="{Binding PlaybackNotice}" Foreground="#8F9BAD" FontSize="11"
                               TextWrapping="Wrap" Margin="0,2,0,12"/>
                    <Border Background="#182131" BorderBrush="#34445C" BorderThickness="1" CornerRadius="6"
                            Padding="10" Margin="0,0,0,10"
                            Visibility="{Binding HasResumeOffer, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ResumeSummary}" Foreground="#D6E2F4" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                    <Button Click="Play_Click" Content="{Binding PrimaryPlayLabel}" Height="40" Margin="0,0,0,8"
                            IsEnabled="{Binding CanPlay}"/>
                    <Button Click="StartOver_Click" Content="Play from beginning" Height="36" Margin="0,0,0,8"
                            Visibility="{Binding HasResumeOffer, Converter={StaticResource BoolToVisibility}}"
                            IsEnabled="{Binding CanPlay}"/>
                    <Button x:Name="FavoriteButton" Click="Favorite_Click" Content="Add to Favorites" Height="34" Margin="0,0,0,8"/>
                    <Button Click="MarkWatched_Click" Content="Mark watched" Height="34" Margin="0,0,0,8"
                            IsEnabled="{Binding CanPlay}"/>
                    <Button Click="MarkUnwatched_Click" Content="Mark unwatched" Height="34" Margin="0,0,0,8"
                            IsEnabled="{Binding HasSelectedEntry}"/>
                    <Button Click="OpenLocation_Click" Content="Open file location" Height="36" Margin="0,0,0,8"/>
                    <Button Click="PlaybackSettings_Click" Content="Playback settings" Height="36"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0F141D" BorderBrush="#27303D" BorderThickness="1" Padding="12" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#AEB8C7" FontSize="12" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
