<Window x:Class="EasyFlix.App.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subtitle activity" Width="980" Height="640" MinWidth="780" MinHeight="480"
        Background="#0B0D12" Foreground="#F6F7FB" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="14" Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Background" Value="#252B38"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#202634"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#303746"/><Setter Property="Padding" Value="6,4"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="#10131A"/><Setter Property="Foreground" Value="White"/><Setter Property="MinHeight" Value="32"/><Style.Triggers><Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#151A24"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel>
                <TextBlock Text="Subtitle activity" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="SummaryText" Text="Loading recent workΓÇª" Foreground="#B4BDCC" Margin="0,6,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#17251F" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                <TextBlock Text="Resumable ┬╖ no overwrite" Foreground="#9BE8C4"/>
            </Border>
        </DockPanel>
        <DataGrid Grid.Row="2" x:Name="ActivityGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  AlternationCount="2" Background="#10131A" BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#303746" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:g}}" Width="145" MinWidth="130"/>
                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="90" MinWidth="80"/>
                <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="110" MinWidth="100"/>
                <DataGridTextColumn Header="Video" Binding="{Binding MediaPath}" Width="*" MinWidth="300"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="300" MinWidth="220"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="FolderText" Foreground="#8E98AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Open activity folder" Click="OpenFolder_Click"/>
                <Button Content="Refresh" Background="#8B7CFF" Click="Refresh_Click"/>
                <Button Content="Close" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
